{
  "name": "Vote",
  "type": "object",
  "properties": {
    "participant_id": {
      "type": "string"
    },
    "voter_id": {
      "type": "string",
      "description": "ID del usuario que vota (null si es invitado)"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "contest_id": {
      "type": "string"
    },
    "round": {
      "type": "number",
      "description": "Ronda de desempate a la que pertenece el voto. Vac\u00edo en la votaci\u00f3n general y mayor a 0 en la ronda de finalistas."
    },
    "voter_ip": {
      "type": "string",
      "description": "IP del votante (para invitados)"
    },
    "device_fingerprint": {
      "type": "string",
      "description": "Huella digital del dispositivo (para anti-fraude)"
    },
    "server_fingerprint": {
      "type": "string",
      "description": "Huella del dispositivo calculada en el servidor (IP + navegador) para anti-fraude"
    },
    "is_guest_vote": {
      "type": "boolean",
      "default": false,
      "description": "True si el voto es de un invitado"
    }
  },
  "required": [
    "participant_id",
    "rating",
    "contest_id"
  ],
  "unique": [
    [
      "voter_id",
      "participant_id",
      "round"
    ],
    [
      "device_fingerprint",
      "participant_id",
      "round"
    ]
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}