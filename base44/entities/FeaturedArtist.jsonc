{
  "name": "FeaturedArtist",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string",
      "description": "Nombre del artista destacado"
    },
    "bio": {
      "type": "string",
      "description": "Biograf\u00eda del artista"
    },
    "profile_image": {
      "type": "string",
      "description": "URL de la imagen de perfil"
    },
    "country": {
      "type": "string",
      "description": "Pa\u00eds del artista"
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop",
        "Rock",
        "Urbano",
        "Balada",
        "Folkl\u00f3rico"
      ],
      "description": "G\u00e9nero musical principal"
    },
    "social_instagram": {
      "type": "string"
    },
    "social_facebook": {
      "type": "string"
    },
    "social_tiktok": {
      "type": "string"
    },
    "followers_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero ficticio de seguidores"
    },
    "participations_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero ficticio de participaciones"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si el artista destacado est\u00e1 activo"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    }
  },
  "required": [
    "artist_name",
    "bio",
    "profile_image",
    "country",
    "genre"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}