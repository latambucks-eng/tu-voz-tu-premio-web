{
  "name": "Follower",
  "type": "object",
  "properties": {
    "fan_id": {
      "type": "string",
      "description": "ID del usuario fan que sigue"
    },
    "artist_id": {
      "type": "string",
      "description": "ID del artista seguido"
    },
    "artist_name": {
      "type": "string",
      "description": "Nombre del artista (para referencia)"
    }
  },
  "required": [
    "fan_id",
    "artist_id",
    "artist_name"
  ],
  "unique": [
    [
      "fan_id",
      "artist_id"
    ]
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "fan_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}